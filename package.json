{
  "name": "make-qr",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./assets/css/tailwind.min.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./assets/css/tailwind.min.css --watch",
    "build:css:standalone": "curl -sL https://github.com/tailwindlabs/tailwindcss/releases/download/v3.4.17/tailwindcss-linux-x64 -o /tmp/tailwindcss && chmod +x /tmp/tailwindcss && /tmp/tailwindcss -i ./src/tailwind.css -o ./assets/css/tailwind.min.css --minify"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
